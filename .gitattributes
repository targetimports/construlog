# Normaliza fim de linha: tudo em LF no repositório (backend roda em Linux/Node).
# Silencia os avisos "LF will be replaced by CRLF" no Windows.
* text=auto eol=lf

# Binários: nunca aplicar conversão de fim de linha.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.tar binary
*.gz binary
